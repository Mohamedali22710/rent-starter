// Hand-written to mirror supabase/migrations/20261029000001_init.sql exactly.
// The SQL migration is the source of truth; do not use `prisma migrate` --
// only `prisma db pull` for verification and `prisma generate` for the client.
//
// Money is BigInt sen everywhere (never floating point). Calendar dates are
// @db.Date, instants are @db.Timestamptz. Prisma connects as the database
// owner (superuser), so RLS is bypassed and authorization is enforced in this
// app's route handlers.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  memberships Membership[]
  units       Unit[]
  tenants     Tenant[]
  leases      Lease[]
  invoices    Invoice[]
  payments    Payment[]
  allocations PaymentAllocation[]
  gatewayBills GatewayBill[]

  @@map("organizations")
}

model Membership {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  role      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId]) // one organization per staff/manager
  @@index([orgId])
  @@map("memberships")
}

model Unit {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leases       Lease[]

  @@index([orgId])
  @@map("units")
}

model Tenant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fullName  String   @map("full_name")
  email     String
  phone     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leases       Lease[]

  @@index([orgId])
  @@index([userId])
  @@map("tenants")
}

model Lease {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @map("org_id") @db.Uuid
  unitId         String   @map("unit_id") @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  monthlyRentSen BigInt   @map("monthly_rent_sen")
  depositSen     BigInt   @default(0) @map("deposit_sen")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit         Unit         @relation(fields: [unitId], references: [id])
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  invoices     Invoice[]
  payments     Payment[]
  gatewayBills GatewayBill[]

  @@index([orgId])
  @@index([unitId])
  @@map("leases")
}

model GatewayBill {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid // the bill id: unguessable
  orgId     String   @map("org_id") @db.Uuid
  leaseId   String   @map("lease_id") @db.Uuid
  amountSen BigInt   @map("amount_sen")
  status    String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lease        Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([leaseId])
  @@map("gateway_bills")
}

model Invoice {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  leaseId     String   @map("lease_id") @db.Uuid
  kind        String   // 'deposit' | 'rent'
  periodIndex Int?     @map("period_index")
  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date
  dueDate     DateTime @map("due_date") @db.Date
  amountSen   BigInt   @map("amount_sen")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lease        Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  allocations  PaymentAllocation[]

  @@index([leaseId])
  @@index([orgId])
  @@index([dueDate])
  @@map("invoices")
}

model Payment {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId         String    @map("org_id") @db.Uuid
  leaseId       String    @map("lease_id") @db.Uuid
  amountSen     BigInt    @map("amount_sen")
  unappliedSen  BigInt    @default(0) @map("unapplied_sen")
  method        String    // 'cash' | 'bank_transfer' | 'online'
  status        String    // 'pending_verification' | 'approved' | 'rejected' | 'voided'
  receivedAt    DateTime  @map("received_at") @db.Timestamptz(6)
  slipPath      String?   @map("slip_path")
  gatewayBillId String?   @map("gateway_bill_id") @db.Uuid
  rejectedReason String?  @map("rejected_reason")
  voidedReason   String?  @map("voided_reason")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy     String?   @map("created_by") @db.Uuid

  organization Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lease        Lease             @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  gatewayBill  GatewayBill?      @relation(fields: [gatewayBillId], references: [id], onDelete: SetNull)
  allocations  PaymentAllocation[]

  @@unique([gatewayBillId]) // a bill settles at most once, ever
  @@index([leaseId])
  @@index([orgId])
  @@map("payments")
}

model PaymentAllocation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  invoiceId String   @map("invoice_id") @db.Uuid
  amountSen BigInt   @map("amount_sen")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payment      Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @map("org_id") @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String
  entityId  String?  @map("entity_id") @db.Uuid
  details   Json     @default(dbgenerated("'{}'::jsonb"))
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([orgId, createdAt(sort: Desc)])
  @@map("audit_log")
}
