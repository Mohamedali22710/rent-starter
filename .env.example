# Where each variable comes from: run `npx supabase status` and copy the
# printed values (replace :54321/:54322 ports etc. accordingly).

# Supabase local stack (npx supabase status) ------------------------------------------------
# API URL ("API URL" line; the browser and server both use this)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable ("anon"/publishable key line). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
# Secret ("service_role"/secret key line). NEVER reachable from the browser.
SUPABASE_SECRET_KEY=

# Postgres direct connection (supabase/proxy said: none; use the DB URL) -----
# "DB URL" from npx supabase status. Prisma connects as the database owner.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Payment gateway webhook secret -------------------------------------------------------------
# HMAC-SHA256 key for the gateway callback signature (brief section 5).
# In grading use the key given in the brief env list; locally any value works
# as long as the same value is set when running the gateway simulator.
GATEWAY_X_SIGNATURE_KEY=local_test_x_signature_key
